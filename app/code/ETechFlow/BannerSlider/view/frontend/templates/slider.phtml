<?php
/**
 * @var \ETechFlow\BannerSlider\Block\Slider $block
 * @var \Magento\Framework\Escaper $escaper
 */

use ETechFlow\BannerSlider\Api\Data\BannerInterface;

// Instead of a silent blank when there is nothing to render, emit a short HTML
// comment explaining WHY, so a merchant can see the reason in the page source
// (View Source / Ctrl+U). The most common cause is a widget that still points at
// a slider that was deleted and recreated under a new id.
if (!$block->isModuleEnabled()) {
    echo '<!-- ETechFlow Banner Slider: the module is disabled or the licence is not valid'
        . ' (Stores > Configuration > ETECHFLOW > Banner Slider). -->';
    return;
}

$slider = $block->getSlider();
if (!$slider) {
    echo '<!-- ETechFlow Banner Slider: slider id ' . (int)$block->getSliderId()
        . ' was not found or is disabled. If the slider was deleted and recreated it now has a'
        . ' different id — edit this widget and re-select the current slider. -->';
    return;
}

if (!$block->hasBanners()) {
    echo '<!-- ETechFlow Banner Slider: slider "' . $escaper->escapeHtml((string)$slider->getTitle())
        . '" (id ' . (int)$slider->getId() . ') has no active banners for this store view. Assign at'
        . ' least one banner and make sure it is enabled, within its schedule, and visible to this store. -->';
    return;
}

$htmlId = $block->getSliderHtmlId();
$showTitle = (bool)$block->getData('show_title');

// Pre-resolve slides so product banners whose product is unavailable are
// dropped up-front — this keeps the track, the bullets and the JS indices
// in sync (both loops below iterate the same $slides array).
$slides = [];
foreach ($block->getBanners() as $row) {
    /** @var \ETechFlow\BannerSlider\Model\Banner $banner */
    $banner = $row['banner'];
    if ($banner->getType() === BannerInterface::TYPE_PRODUCT) {
        $product = $block->getProductData($banner);
        if (!$product) {
            continue;
        }
        $row['product'] = $product;
    }
    $row['target'] = $block->getTargetingJson($banner);
    $slides[] = $row;
}
if (!$slides) {
    echo '<!-- ETechFlow Banner Slider: every banner in this slider was skipped (for example a'
        . ' product banner whose product is unavailable in this store). -->';
    return;
}
$slideCount = count($slides);
?>
<div id="<?= $escaper->escapeHtmlAttr($htmlId) ?>"
     class="etf-bannerslider effect-<?= $escaper->escapeHtmlAttr($slider->getAnimationEffect()) ?>"
     data-slider-id="<?= (int)$slider->getId() ?>">

    <?php if ($showTitle && $slider->getTitle()): ?>
        <h2 class="etf-bannerslider__title"><?= $escaper->escapeHtml($slider->getTitle()) ?></h2>
    <?php endif; ?>

    <div class="etf-bannerslider__viewport">
        <ul class="etf-bannerslider__track">
            <?php foreach ($slides as $index => $row): ?>
                <?php
                /** @var \ETechFlow\BannerSlider\Model\Banner $banner */
                $banner = $row['banner'];
                $type = $banner->getType();
                $isFirst = $index === 0;
                $href = $banner->getUrl();
                $target = $banner->getOpenNewTab() ? '_blank' : '_self';
                // Product banners carry their own links/buttons; videos must stay
                // interactive — so only wrap the simple visual types.
                $wrap = $href && in_array(
                    $type,
                    [BannerInterface::TYPE_IMAGE, BannerInterface::TYPE_HTML, BannerInterface::TYPE_COUNTDOWN],
                    true
                );
                ?>
                <?php $targetJson = $row['target']; ?>
                <li class="etf-bannerslider__slide etf-bannerslider__slide--<?= $escaper->escapeHtmlAttr($type) ?><?= $isFirst ? ' is-active' : '' ?><?= $targetJson ? ' is-pending-target' : '' ?>"
                    data-banner-id="<?= (int)$banner->getId() ?>"
                    data-variant="<?= $escaper->escapeHtmlAttr($row['variant']) ?>"
                    <?php if ($targetJson): ?>data-etf-target="<?= $escaper->escapeHtmlAttr($targetJson) ?>"<?php endif; ?>
                    data-index="<?= (int)$index ?>">
                    <?php if ($wrap): ?>
                        <a href="<?= $escaper->escapeUrl($href) ?>"
                           target="<?= $escaper->escapeHtmlAttr($target) ?>"
                           rel="<?= $target === '_blank' ? 'noopener' : '' ?>"
                           class="etf-bannerslider__link"
                           data-etf-track="click">
                    <?php endif; ?>

                    <?php switch ($type):
                        case BannerInterface::TYPE_VIDEO: ?>
                            <?php $v = $block->getVideoData($banner); ?>
                            <div class="etf-bannerslider__video"
                                 data-etf-video="<?= $escaper->escapeHtmlAttr($v['provider']) ?>"
                                 data-autoplay="<?= $v['autoplay'] ? '1' : '0' ?>"
                                 <?php if ($v['embed_url']): ?>data-embed="<?= $escaper->escapeHtmlAttr($v['embed_url']) ?>"<?php endif; ?>>
                                <?php if ($v['provider'] === 'mp4' && $v['src']): ?>
                                    <video class="etf-bannerslider__video-el" preload="none"
                                           playsinline loop
                                           <?= $v['muted'] ? 'muted' : '' ?>
                                           <?= $v['autoplay'] ? 'data-etf-autoplay="1"' : '' ?>>
                                        <source src="<?= $escaper->escapeUrl($v['src']) ?>" type="video/mp4"/>
                                    </video>
                                <?php elseif ($v['embed_url']): ?>
                                    <button type="button" class="etf-bannerslider__video-play"
                                            aria-label="<?= $escaper->escapeHtmlAttr(__('Play video')) ?>">
                                        <span class="etf-bannerslider__video-play-icon" aria-hidden="true">&#9658;</span>
                                    </button>
                                <?php endif; ?>
                            </div>
                            <?php break; ?>

                        <?php case BannerInterface::TYPE_HTML: ?>
                            <div class="etf-bannerslider__html"><?= /* @noEscape */ $banner->getContent() ?></div>
                            <?php break; ?>

                        <?php case BannerInterface::TYPE_PRODUCT: ?>
                            <?php $p = $row['product']; ?>
                            <div class="etf-bannerslider__product">
                                <a href="<?= $escaper->escapeUrl($p['url']) ?>" class="etf-bannerslider__product-media">
                                    <img src="<?= $escaper->escapeUrl($p['image_url']) ?>"
                                         alt="<?= $escaper->escapeHtmlAttr($p['name']) ?>"
                                         loading="<?= $isFirst ? 'eager' : 'lazy' ?>"/>
                                </a>
                                <div class="etf-bannerslider__product-info">
                                    <a href="<?= $escaper->escapeUrl($p['url']) ?>" class="etf-bannerslider__product-name">
                                        <?= $escaper->escapeHtml($p['name']) ?>
                                    </a>
                                    <div class="etf-bannerslider__product-price">
                                        <?php if ($p['regular_price']): ?>
                                            <span class="etf-bannerslider__price-old"><?= $escaper->escapeHtml($p['regular_price']) ?></span>
                                        <?php endif; ?>
                                        <span class="etf-bannerslider__price-final"><?= $escaper->escapeHtml($p['final_price']) ?></span>
                                    </div>
                                    <div class="etf-bannerslider__product-actions">
                                        <?php if ($p['in_stock']): ?>
                                            <button type="button" class="action primary etf-bannerslider__tocart"
                                                    data-post='<?= /* @noEscape */ $p['add_to_cart'] ?>'>
                                                <span><?= $escaper->escapeHtml(__('Add to Cart')) ?></span>
                                            </button>
                                        <?php else: ?>
                                            <span class="etf-bannerslider__unavailable"><?= $escaper->escapeHtml(__('Out of stock')) ?></span>
                                        <?php endif; ?>
                                        <a href="<?= $escaper->escapeUrl($p['url']) ?>" class="action secondary etf-bannerslider__view">
                                            <?= $escaper->escapeHtml(__('View Product')) ?>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <?php break; ?>

                        <?php case BannerInterface::TYPE_COUNTDOWN: ?>
                            <?php $cd = $block->getCountdownData($banner); ?>
                            <div class="etf-bannerslider__countdown"
                                 <?php if ($cd): ?>data-etf-countdown="<?= (int)$cd['ts'] ?>"
                                 data-hide-expired="<?= $cd['hide_expired'] ? '1' : '0' ?>"<?php endif; ?>>
                                <?php if ($banner->getName()): ?>
                                    <div class="etf-bannerslider__countdown-label"><?= $escaper->escapeHtml($banner->getName()) ?></div>
                                <?php endif; ?>
                                <div class="etf-bannerslider__countdown-units">
                                    <span class="etf-bannerslider__countdown-unit"><b data-unit="days">--</b><i><?= $escaper->escapeHtml(__('Days')) ?></i></span>
                                    <span class="etf-bannerslider__countdown-unit"><b data-unit="hours">--</b><i><?= $escaper->escapeHtml(__('Hours')) ?></i></span>
                                    <span class="etf-bannerslider__countdown-unit"><b data-unit="minutes">--</b><i><?= $escaper->escapeHtml(__('Min')) ?></i></span>
                                    <span class="etf-bannerslider__countdown-unit"><b data-unit="seconds">--</b><i><?= $escaper->escapeHtml(__('Sec')) ?></i></span>
                                </div>
                            </div>
                            <?php break; ?>

                        <?php default: ?>
                            <?php
                            $desktop = $block->getMediaUrl($banner->getImage());
                            $mobile = $banner->getImageMobile() ? $block->getMediaUrl($banner->getImageMobile()) : $desktop;
                            $webpDesktop = $block->getWebpUrl($banner->getImage());
                            $webpMobile = $banner->getImageMobile() ? $block->getWebpUrl($banner->getImageMobile()) : $webpDesktop;
                            $alt = $banner->getAltText() ?: $banner->getName();
                            $lazy = !$isFirst && $block->isLazyLoadEnabled();
                            $ss = $lazy ? 'data-srcset' : 'srcset';
                            ?>
                            <?php if ($desktop): ?>
                                <picture>
                                    <?php if ($webpMobile && $mobile !== $desktop): ?>
                                        <source media="(max-width: 768px)" <?= /* @noEscape */ $ss ?>="<?= $escaper->escapeUrl($webpMobile) ?>" type="image/webp"/>
                                    <?php endif; ?>
                                    <?php if ($mobile !== $desktop): ?>
                                        <source media="(max-width: 768px)" <?= /* @noEscape */ $ss ?>="<?= $escaper->escapeUrl($mobile) ?>"/>
                                    <?php endif; ?>
                                    <?php if ($webpDesktop): ?>
                                        <source <?= /* @noEscape */ $ss ?>="<?= $escaper->escapeUrl($webpDesktop) ?>" type="image/webp"/>
                                    <?php endif; ?>
                                    <img
                                        <?php if ($lazy): ?>
                                            data-src="<?= $escaper->escapeUrl($desktop) ?>"
                                            src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg'/%3E"
                                            loading="lazy"
                                        <?php else: ?>
                                            src="<?= $escaper->escapeUrl($desktop) ?>"
                                            loading="eager"<?php if ($isFirst): ?> fetchpriority="high"<?php endif; ?>
                                        <?php endif; ?>
                                        class="etf-bannerslider__image"
                                        alt="<?= $escaper->escapeHtmlAttr($alt) ?>"/>
                                </picture>
                            <?php endif; ?>
                    <?php endswitch; ?>

                    <?php if ($wrap): ?></a><?php endif; ?>
                </li>
            <?php endforeach; ?>
        </ul>

        <?php if ($slider->getShowArrows() && $slideCount > 1): ?>
            <button type="button" class="etf-bannerslider__arrow etf-bannerslider__arrow--prev"
                    aria-label="<?= $escaper->escapeHtmlAttr(__('Previous')) ?>">&#8249;</button>
            <button type="button" class="etf-bannerslider__arrow etf-bannerslider__arrow--next"
                    aria-label="<?= $escaper->escapeHtmlAttr(__('Next')) ?>">&#8250;</button>
        <?php endif; ?>
    </div>

    <?php if ($slider->getShowBullets() && $slideCount > 1): ?>
        <div class="etf-bannerslider__bullets" role="tablist">
            <?php for ($i = 0; $i < $slideCount; $i++): ?>
                <button type="button"
                        class="etf-bannerslider__bullet<?= $i === 0 ? ' is-active' : '' ?>"
                        data-index="<?= (int)$i ?>"
                        aria-label="<?= $escaper->escapeHtmlAttr(__('Go to slide %1', $i + 1)) ?>"></button>
            <?php endfor; ?>
        </div>
    <?php endif; ?>
</div>

<script type="text/x-magento-init">
{
    "#<?= $escaper->escapeJs($htmlId) ?>": {
        "etfBannerSlider": <?= /* @noEscape */ $block->getJsConfig() ?>
    }
}
</script>

<?php /* Hyvä support: the storefront styles ship as LESS (Luma pipeline only), so Hyvä —
        which does not compile Magento LESS — gets NO slider CSS and the slides render
        unstyled/stacked. Emit the compiled equivalent inline so the slider is styled on
        BOTH themes (identical rules → harmless on Luma). */ ?>
<style id="ef-bs-hyva-css">
.etf-bannerslider{position:relative;margin:0 0 20px}
.etf-bannerslider__title{margin:0 0 12px}
.etf-bannerslider__viewport{position:relative;overflow:hidden;aspect-ratio:16/5;background:#f4f4f4}
.etf-bannerslider__track{list-style:none;margin:0;padding:0;height:100%}
.etf-bannerslider__slide{position:absolute;inset:0;margin:0;opacity:0;visibility:hidden;transition:opacity .5s ease}
.etf-bannerslider__slide.is-active{opacity:1;visibility:visible;z-index:1}
.etf-bannerslider__slide.is-pending-target{opacity:0;visibility:hidden}
.etf-bannerslider.effect-slide .etf-bannerslider__slide{transform:translateX(30px);transition:opacity .5s ease,transform .5s ease}
.etf-bannerslider.effect-slide .etf-bannerslider__slide.is-active{transform:translateX(0)}
.etf-bannerslider__link,.etf-bannerslider picture{display:block;width:100%;height:100%}
.etf-bannerslider__image{width:100%;height:100%;object-fit:cover;display:block}
.etf-bannerslider__html{width:100%;height:100%}
.etf-bannerslider__arrow{position:absolute;top:50%;transform:translateY(-50%);z-index:2;border:0;cursor:pointer;width:40px;height:40px;font-size:26px;line-height:1;color:#fff;background:rgba(0,0,0,.35);border-radius:50%;transition:background .2s ease}
.etf-bannerslider__arrow:hover{background:rgba(0,0,0,.6)}
.etf-bannerslider__arrow--prev{left:12px}
.etf-bannerslider__arrow--next{right:12px}
.etf-bannerslider__bullets{display:flex;justify-content:center;gap:8px;margin-top:10px}
.etf-bannerslider__bullet{width:10px;height:10px;padding:0;border:0;border-radius:50%;cursor:pointer;background:#ccc;transition:background .2s ease}
.etf-bannerslider__bullet.is-active{background:#333}
@media (max-width:768px){.etf-bannerslider__viewport{aspect-ratio:4/3}.etf-bannerslider__arrow{width:32px;height:32px;font-size:20px}}
</style>
<?php /* Hyvä support: Hyvä strips requireJS + text/x-magento-init, so the requireJS
        slider above never initialises. This guarded vanilla controller runs ONLY when
        requireJS is absent (i.e. Hyvä); on Luma window.require exists and the
        x-magento-init path handles it. Reuses the same markup + CSS (crossfade via
        .is-active) and honours the admin settings. */ ?>
<script>
(function () {
    if (window.require) { return; } // Luma path handles it via requireJS
    var root = document.getElementById('<?= $escaper->escapeJs($htmlId) ?>');
    if (!root || root.dataset.efHyvaInit) { return; }
    root.dataset.efHyvaInit = '1';
    var cfg = <?= /* @noEscape */ $block->getJsConfig() ?>;
    var slides  = Array.prototype.slice.call(root.querySelectorAll('.etf-bannerslider__slide'));
    var bullets = Array.prototype.slice.call(root.querySelectorAll('.etf-bannerslider__bullet'));
    if (slides.length < 1) { return; }
    var cur = 0, timer = null;
    function loadSlide(el) {
        el.querySelectorAll('source[data-srcset]').forEach(function (so) { so.srcset = so.getAttribute('data-srcset'); so.removeAttribute('data-srcset'); });
        el.querySelectorAll('img').forEach(function (im) {
            if (im.getAttribute('data-src')) { im.src = im.getAttribute('data-src'); im.removeAttribute('data-src'); }
            if (im.loading === 'lazy') { im.loading = 'eager'; if (!im.complete || !im.naturalWidth) { var u = im.getAttribute('src'); if (u) { im.src = ''; im.src = u; } } }
        });
    }
    function show(i) {
        var n = slides.length; i = (i % n + n) % n;
        loadSlide(slides[i]); loadSlide(slides[(i + 1) % n]);
        slides.forEach(function (s, k) { s.classList.toggle('is-active', k === i); });
        bullets.forEach(function (b, k) { b.classList.toggle('is-active', k === i); });
        cur = i;
    }
    function nxt() { (!cfg.loop && cur === slides.length - 1) ? show(0) : show(cur + 1); }
    function prv() { show(cur - 1); }
    function speed() { var s = parseInt(cfg.autoplaySpeed, 10) || 5000; if (s < 100) { s *= 1000; } return Math.max(1500, s); }
    function start() { if (!cfg.autoplay || slides.length < 2) { return; } stop(); timer = setInterval(nxt, speed()); }
    function stop() { if (timer) { clearInterval(timer); timer = null; } }
    var an = root.querySelector('.etf-bannerslider__arrow--next');
    var ap = root.querySelector('.etf-bannerslider__arrow--prev');
    if (an) { an.addEventListener('click', function () { nxt(); start(); }); }
    if (ap) { ap.addEventListener('click', function () { prv(); start(); }); }
    bullets.forEach(function (b) { b.addEventListener('click', function () { show(parseInt(b.getAttribute('data-index'), 10) || 0); start(); }); });
    if (cfg.pauseOnHover) { root.addEventListener('mouseenter', stop); root.addEventListener('mouseleave', start); }
    // Targeting: the requireJS path defers slides whose rules need customer-data
    // (group/login/cart/country), reveals them on a fail-open timeout, then prunes
    // the ones that do not match once the section arrives. None of that machinery
    // runs here, because targeting.js is requireJS-only.
    //
    // Without this, any slide carrying targeting rules keeps `is-pending-target`
    // forever, and that class is defined AFTER `.is-active` at equal specificity —
    // so it wins, and the slider renders a permanently blank viewport. That is
    // strictly worse than showing the banner: a merchant sees an empty hero and no
    // error. Fail open, exactly as the requireJS path already does on timeout.
    //
    // Precise per-visitor targeting on Hyva is the job of the ETechFlow_BannerSliderHyva
    // companion module, which fetches the customer-data section directly.
    function efRevealPendingTarget() {
        slides.forEach(function (s) { s.classList.remove('is-pending-target'); });
    }
    efRevealPendingTarget();

    show(0); start();
})();
</script>
