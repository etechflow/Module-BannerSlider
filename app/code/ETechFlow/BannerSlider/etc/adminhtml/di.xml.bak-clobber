<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!--
      Admin UI-listing grid collections.

      MUST be declared in the adminhtml scope (this file), NOT in the global
      etc/di.xml. The `collections` array argument of the shared CollectionFactory
      is REPLACED (not deep-merged) when an area-scope definition extends the
      global one at runtime. Another module here (Etechflow_Blog) registers its
      grids in etc/adminhtml/di.xml; that adminhtml-scope array replaced our
      global-scope array, so the slider/banner grids threw
      "Not registered handle etechflow_bannerslider_*_listing_data_source".
      Declaring ours in the same (adminhtml) scope makes the item arrays merge
      by name, so both Blog's and our grids resolve.

      The referenced virtualTypes (…\Slider\Grid\Collection,
      …\Banner\Grid\Collection) are defined in the global etc/di.xml and resolve
      fine here because they are referenced by fully-qualified string.
    -->
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="etechflow_bannerslider_slider_listing_data_source" xsi:type="string">ETechFlow\BannerSlider\Model\ResourceModel\Slider\Grid\Collection</item>
                <item name="etechflow_bannerslider_banner_listing_data_source" xsi:type="string">ETechFlow\BannerSlider\Model\ResourceModel\Banner\Grid\Collection</item>
            </argument>
        </arguments>
    </type>

</config>
